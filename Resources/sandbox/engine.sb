;; The one sandbox profile of every pro-engine process (sandbox-exec -f engine.sb -D KEY=VALUE ...).
;; Parameters (all are always given; an unused root repeats WORK):
;;   WORK OUT ROOT1 ROOT2 ROOT3 ROOT4   the folders the process may write to
;;   DCACHE DTEMP                       the Darwin user cache and temp folders (getconf DARWIN_USER_CACHE_DIR / _TEMP_DIR)
;;   NET                                deny-ip: no IP traffic (AF_UNIX, DataLoader and torch_shm_manager still work), allow: all
;; Reads and exec stay open (Python, torch and the models are read from all over the disk): this limits writes and
;; the internet, it is not a confidentiality boundary.
(version 1)
(allow default)
(if (string=? (param "NET") "deny-ip")
    (begin
      (deny network-outbound (remote ip))
      (deny network-inbound (local ip))
      (deny network-bind (local ip))))
(deny file-write*)
(allow file-write*
    (literal "/dev/null")
    (regex #"^/dev/tty")
    (regex #"^/dev/dtracehelper$")
    (subpath (param "WORK"))
    (subpath (param "OUT"))
    (subpath (param "ROOT1"))
    (subpath (param "ROOT2"))
    (subpath (param "ROOT3"))
    (subpath (param "ROOT4"))
    (subpath (param "DCACHE"))
    (subpath (param "DTEMP")))
